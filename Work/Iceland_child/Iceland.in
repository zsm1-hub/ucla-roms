title:
   Test for Iceland.

time_stepping: NTIMES   dt[sec]  NDTFAST  NINFO
               86400        30       10       1

S-coord: THETA_S,   THETA_B,    hc (m)
          6.0D0        6.0D0     200.0D0

grid:  filename
     input_data/Iceland_chgrd.nc

forcing: filename
     input_data/Iceland_child_era.nc
     input_data/Iceland_child_bry.nc
     input_data/Iceland_child_tide.nc 
  
initial: NRREC  filename
          0
     input_data/Iceland_chd_initial.nc

output_root_name:
     /leader/user/zsm/output-ucla/child/Iceland

lateral_visc:   VISC2,    VISC4    [m^2/sec for all]
                 0.       0.

rho0:
      1027.5

v_sponge:           V_SPONGE [m^2/sec]
                   1.

vertical_mixing:  Akv  Akt1  Akt2
                  0.0  0.0   0.0


tracer_diff2: TNU2(1:NT)           [m^2/sec for all]
 0. 0. 0. 0. 0. 0. 0. 0. 0.

bottom_drag:     RDRG [m/s],  RDRG2,  Zob [m],  Cdb_min, Cdb_max
                  0.E-4       1.0E-3   1.E-2     1.E-4    1.E-2

gamma2:
                  1.D0

ubind: OBC binding velocity scale [m/s]
       0.1

