      integer,parameter :: nrpf_avg           = 144
      logical,parameter :: wrt_avg_Z=.false., wrt_avg_Ub=.false.,
     &                     wrt_avg_Vb=.false., wrt_avg_U=.false.,
     &                     wrt_avg_V=.false., wrt_avg_R=.false.,
