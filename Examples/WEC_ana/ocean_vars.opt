     &                     wrt_U=.true., wrt_V=.true., wrt_R=.false.,
     &                     wrt_O=.false., wrt_W=.false., wrt_Akv=.false.,
     &                     wrt_Akt=.false., wrt_Aks=.false.,
     &                     wrt_Hbls=.false., wrt_Hbbl=.false.

      logical,parameter :: wrt_file_avg      = .false.
