      logical,parameter :: wrt_file_rst      = .false.
      real,parameter    :: output_period_rst = 86400
      logical,parameter :: monthly_restarts  = .false.
      integer,parameter :: nrpf_rst           = 1

      logical,parameter :: wrt_file_his      = .true.
      real,parameter    :: output_period_his = 600
